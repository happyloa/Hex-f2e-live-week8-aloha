{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./*"],
      "next/navigation": ["./node_modules/vinext/dist/shims/navigation.d.ts"]
    }
  },
  "include": ["app", "components", "lib", "vite.config.ts"]
}
